# Base URL used to resolve canonical/Open Graph URLs. Defaults to https://brianpontes.dev if unset.
NEXT_PUBLIC_SITE_URL=

# Sanity project configuration.
# Public, read-only values used by the client SDK (safe to expose to the browser).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# GROQ/API version the client targets. See https://www.sanity.io/docs/api-versioning
SANITY_API_VERSION=2024-01-01

# Optional: only required if the dataset is private. Server-side only, never exposed to the browser.
SANITY_API_READ_TOKEN=

# Base URL of the personal-resume-backend API (LinkedIn auth + article reactions).
# Optional: if unset, the reaction section on article pages does not render.
NEXT_PUBLIC_REACTIONS_API_URL=
